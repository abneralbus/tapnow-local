{
  "manifest_version": 3,
  "name": "Flowboard 连接助手",
  "version": "0.1.1",
  "description": "将本地 Flowboard 画布连接到 Chrome 中已登录的 Google Flow 页面。",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "webRequest",
    "scripting",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://flow-content.google/*",
    "https://labs.google/*",
    "https://aisandbox-pa.googleapis.com/*",
    "http://127.0.0.1:8434/*",
    "http://localhost:8434/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Flowboard 连接助手",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/fx/tools/flow*",
        "https://labs.google/fx/*/tools/flow*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/fx/tools/flow*",
        "https://labs.google/fx/*/tools/flow*"
      ],
      "js": [
        "injected.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js"
      ],
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/*"
      ]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "flowboard_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
